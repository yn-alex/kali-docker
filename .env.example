# Copy to .env and edit. Every line is optional.

# Folder on the host that appears as ~/work in the container (created if missing).
# Use forward slashes on Windows. Pick the line for your OS:
#KALI_WORKDIR=/Users/<you>/kali-workspace
#KALI_WORKDIR=C:/Users/<you>/kali-workspace
#KALI_WORKDIR=/home/<you>/kali-workspace

# Linux only: make files in the work folder belong to you (run `id -u` and `id -g`).
# Docker Desktop on macOS and Windows maps ownership itself; leave these unset there.
#KALI_UID=1000
#KALI_GID=1000

# Where the desktop ports listen on the host (default: loopback only).
#KALI_RDP=127.0.0.1:3389
#KALI_NOVNC=127.0.0.1:6080

# Passwords (defaults: kali / kalikali). The VNC password needs 6 to 8 characters.
#KALI_PASSWORD=
#KALI_VNC_PASSWORD=

# Images. By default compose pulls the published ones and builds locally
# only if the pull fails.
#KALI_IMAGE=ghcr.io/yn-alex/kali-docker
#KALI_CLI_TAG=cli
#KALI_GUI_TAG=gui
# daily (default), always, missing, never or build (build = always build locally)
#KALI_PULL=daily

# Tool set for local builds (empty = the Dockerfile's default: Kali top 10 plus beginner tools).
#KALI_PACKAGES=
